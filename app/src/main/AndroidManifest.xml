<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.app.trendize">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera" />
    <uses-feature android:name="android.hardware.camera.autofocus" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MGXChange"
        android:usesCleartextTraffic="true"
        tools:replace="android:icon">
        <activity android:name="com.app.trendize.activities.UserUpdateProfile" />
        <activity android:name="com.app.trendize.activities.ItemListDetails" />
        <activity android:name="com.app.trendize.activities.ComplainListDetails" />
        <activity android:name="com.app.trendize.activities.ComplainList" />
        <activity android:name="com.app.trendize.activities.AddProductToSell" />
        <activity android:name="com.app.trendize.activities.ItemsList" />
        <activity android:name="com.app.trendize.activities.DetailedUserProfile" />
        <activity android:name="com.app.trendize.activities.AddProductToGetLoan" />
        <activity android:name="com.app.trendize.activities.LoanOrSellSelection" />
        <activity android:name="com.app.trendize.activities.AddComplain" />
        <activity android:name="com.app.trendize.activities.Welcome" />
        <activity android:name="com.app.trendize.activities.SplashScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.app.trendize.activities.ForgetPassword" />
        <activity android:name="com.app.trendize.activities.UserSignUp" />
        <activity android:name="com.app.trendize.activities.UserLogin" />
        <activity android:name="com.app.trendize.activities.PrivacyPolicy" />
        <activity
            android:name="com.app.trendize.activities.Dashboard"
            android:label="@string/title_activity_dashboard" />
    </application>

</manifest>